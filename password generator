import secrets
import string

def generate_password(length, use_letters, use_digits, use_symbols):
    characters = ""
    required = []

    if use_letters:
        characters += string.ascii_letters
        required.append(secrets.choice(string.ascii_letters))

    if use_digits:
        characters += string.digits
        required.append(secrets.choice(string.digits))

    if use_symbols:
        symbols = "!@#$%^&*()-_=+?"
        characters += symbols
        required.append(secrets.choice(symbols))

    if not characters:
        raise ValueError("Select at least one character type.")

    if length < len(required):
        raise ValueError("Password length is too short.")

    password = required[:]

    for _ in range(length - len(password)):
        password.append(secrets.choice(characters))

    secrets.SystemRandom().shuffle(password)

    return "".join(password)


while True:
    print("\n--- Password Generator ---")

    try:
        length = int(input("Enter password length: "))

        letters = input("Include letters? (yes/no): ").lower() == "yes"
        digits = input("Include numbers? (yes/no): ").lower() == "yes"
        symbols = input("Include symbols? (yes/no): ").lower() == "yes"

        password = generate_password(length, letters, digits, symbols)

        print("Generated Password:", password)

    except ValueError as error:
        print("Error:", error)

    choice = input("Generate another password? (yes/no): ").lower()

    if choice != "yes":
        break
